# Project Akshara — copy to .env and fill in. .env is gitignored and never committed (Principle 9).
#
# Everything in this file is FREE-TIER ONLY (plan §4). No key here may bill you.

# Hugging Face — needed to download gated datasets/models and to push your own.
# Create a READ token at https://huggingface.co/settings/tokens
# A read token cannot delete your repos; use write only on the day you actually push.
HF_TOKEN=

# Weights & Biases (optional) — experiment tracking, free personal tier.
# Leave blank to log runs to docs/RUNS.md and a local CSV only, which is the default.
WANDB_API_KEY=

# Where large artifacts live. These paths are gitignored; never point them inside the repo's
# tracked tree. Principle 9: the repo holds what reproduces a model, never the model.
AKSHARA_DATA_DIR=./data
AKSHARA_CHECKPOINT_DIR=./checkpoints

# Set to 1 to force CPU even when CUDA is available - used to prove every day's T0 path works.
AKSHARA_FORCE_CPU=0
